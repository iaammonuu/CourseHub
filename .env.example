# CourseHub Environment Configuration
PORT=3000
NODE_ENV=development

# MongoDB Connection URI (automatically falls back to persistent local MongoDB document store if no external mongod is reachable)
MONGODB_URI=mongodb://127.0.0.1:27017/coursehub

# JWT Authentication Secret & Expiration
JWT_SECRET=coursehub_university_enterprise_jwt_secret_key_2026
JWT_EXPIRES_IN=7d

# Default Registration & Drop Deadlines (ISO 8601)
DEFAULT_REGISTRATION_DEADLINE=2027-05-15T23:59:59.000Z
DEFAULT_DROP_DEADLINE=2027-04-30T23:59:59.000Z

# AI Studio Runtime Variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
